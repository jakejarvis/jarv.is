{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "sortImports": {
    "groups": [
      "builtin",
      "external",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "style",
      "unknown"
    ],
    "internalPattern": ["@/"],
    "newlinesBetween": true,
    "order": "asc"
  },
  "sortTailwindcss": {
    "stylesheet": "src/styles/globals.css",
    "attributes": ["className"],
    "functions": ["cn", "clsx", "cva"]
  },
  "overrides": [
    {
      "files": ["**/*.json", "**/*.jsonc"],
      "options": {
        "trailingComma": "none"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules",
    ".vercel",
    ".output",
    ".nitro",
    ".tanstack",
    ".content-collections",
    "src/routeTree.gen.ts",
    "drizzle"
  ]
}
