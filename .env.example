# --- required to build ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_LOCALE=en-US
# GitHub "owner/repo" for "Improve This Post" links, and the username shown on /projects
NEXT_PUBLIC_GITHUB_REPO=
NEXT_PUBLIC_GITHUB_USERNAME=

# --- views & comments (Postgres) ---
DATABASE_URL=

# --- sign-in for comments (GitHub OAuth app via Better Auth) ---
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# optional: Better Auth infra dashboard
BETTER_AUTH_API_KEY=

# --- optional ---
# GitHub token for /projects (the page 404s without it)
GITHUB_TOKEN=
# Tor mirror hostname, adds an onion-location header
NEXT_PUBLIC_ONION_DOMAIN=
