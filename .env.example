# --- required to build ---
VITE_BASE_URL=http://localhost:3000
VITE_SITE_LOCALE=en-US
# GitHub "owner/repo" for "Improve This Post" links, and the username shown on /projects
VITE_GITHUB_REPO=
VITE_GITHUB_USERNAME=

# --- views & comments (Postgres) ---
DATABASE_URL=

# --- sign-in for comments (GitHub OAuth app via Better Auth) ---
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# optional: Better Auth infra dashboard
BETTER_AUTH_API_KEY=

# --- optional ---
# GitHub token for /projects (the page 404s without it)
GITHUB_TOKEN=
